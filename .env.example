# Reddit app credentials (https://www.reddit.com/prefs/apps, app type "script").
# Copy this file to .env and fill in the values. .env is not committed.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks for: <platform>:<app name>:<version> (by /u/<your username>)
REDDIT_USER_AGENT=macos:earnings-calendar:v0.1 (by /u/your_username)
